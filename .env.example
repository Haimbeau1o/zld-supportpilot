APP_NAME=zld-supportpilot
APP_ENV=dev
HTTP_ADDR=:8080
AUTH_SIGNING_KEY=dev-only-signing-key
AUTH_TOKEN_TTL_SECONDS=3600
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_RPS=5
HTTP_RATE_LIMIT_BURST=10
APP_PERSISTENCE_MODE=memory
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/supportpilot?sslmode=disable
DOCUMENT_STORAGE_MODE=memory
DOCUMENT_STORAGE_ROOT=data/documents

REDIS_ADDR=localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
